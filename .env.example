# Default path: local Ollama. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window sent to Ollama. Narrow --since/--until if a range does not fit.
OLLAMA_NUM_CTX=8192

# ollama (default) or openai (any OpenAI-compatible /chat/completions server).
CHANGELOG_PROVIDER=ollama

# Seconds to wait for the model call.
CHANGELOG_TIMEOUT=120

# Optional OpenAI-compatible path. Used only when CHANGELOG_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
